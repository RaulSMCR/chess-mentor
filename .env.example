# Perfil: local | cloud | hybrid
APP_PROFILE=local
NEXT_PUBLIC_APP_NAME=Chess Mentor

# Solo rutas creadas expresamente para Chess Mentor.
LOCAL_DATA_DIR=
LOCAL_ORIGINALS_DIR=
LOCAL_CACHE_DIR=

# Worker local futuro: siempre loopback, nunca 0.0.0.0.
LOCAL_WORKER_URL=http://127.0.0.1:3210
LOCAL_WORKER_TOKEN=

# Stockfish. Fase 2 usa WASM en navegador; la ruta nativa es opcional futura.
STOCKFISH_PATH=
STOCKFISH_DEFAULT_DEPTH=16
STOCKFISH_DEFAULT_MULTIPV=3

# Ollama. Los modelos se instalan y prueban manualmente.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=mistral-nemo:12b
OLLAMA_EMBEDDING_MODEL=
OLLAMA_KEEP_ALIVE=0

# PostgreSQL futuro. Reservar 5433 para no tocar el servicio existente en 5432.
DATABASE_URL=postgresql://chess_mentor:change_me@127.0.0.1:5433/chess_mentor?schema=public

# Obsidian y Google Drive: vacíos hasta sus fases, sin rutas o tokens reales en Git.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_EXPORT_DIR=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Nube opcional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedores externos opcionales. Nunca son requisito del modo local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
